{
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  },
  "scripts": {
    "sync": "bash bin/shell_cmd.sh",
    "check:links": "npm run sync && node bin/check-docs-links.mjs",
    "check:links:anchors": "node bin/check-docs-links.mjs --anchors",
    "docs:dev": "npm run sync && vitepress dev docs",
    "docs:build": "npm run sync && NODE_OPTIONS='--max-old-space-size=8192' vitepress build docs",
    "docs:preview": "vitepress preview docs"
  }
}
